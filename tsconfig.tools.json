{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["*.ts", "packages/*/test/**/*.ts", "infrastructure/scripts/*.mjs"]
}
