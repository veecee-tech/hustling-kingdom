{
  "name": "hustling-kingdom",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test": "pnpm --filter \"./packages/*\" build && vitest run --config vitest.config.ts",
    "test:integration": "pnpm --filter \"./packages/*\" build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter \"./packages/*\" build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @hk/api prisma:generate",
    "prisma:migrate": "pnpm --filter @hk/api prisma:migrate",
    "prisma:deploy": "pnpm --filter @hk/api prisma:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@vue/test-utils": "^2.4.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
