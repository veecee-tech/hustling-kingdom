generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(254)
  username           String              @unique @db.VarChar(24)
  passwordHash       String              @map("password_hash")
  role               UserRole            @default(PLAYER)
  status             UserStatus          @default(ACTIVE)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz
  lastLoginAt        DateTime?           @map("last_login_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  sessions           AuthSession[]
  character          Character?
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

enum CharacterGender {
  MALE
  FEMALE
  NON_BINARY
}

enum CharacterStatus {
  ACTIVE
}

model Character {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @unique @map("user_id") @db.Uuid
  name             String              @db.VarChar(40)
  slug             String              @unique @db.VarChar(40)
  gender           CharacterGender
  appearance       Json                @db.JsonB
  status           CharacterStatus     @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  creationKey      String              @map("creation_key") @db.VarChar(128)
  creationHash     String              @map("creation_hash") @db.Char(64)
  creationResponse Json?               @map("creation_response") @db.JsonB
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats            CharacterStats?
  wallet           Wallet?
  transactions     WalletTransaction[]
  jobAssignments   JobAssignment[]
  skills           CharacterSkill[]
  hustleAttempts   HustleAttempt[]

  @@map("characters")
}

model CharacterStats {
  characterId     String    @id @map("character_id") @db.Uuid
  reputation      BigInt    @default(0)
  heat            Int       @default(0)
  health          Int       @default(100)
  energy          Int       @default(100)
  stress          Int       @default(10)
  highestNetWorth BigInt    @default(0) @map("highest_net_worth")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_stats")
}

// Each rotated credential has its own row. Spent digests remain until expiry
// so reuse can revoke the family without ever storing a bearer credential.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum WalletAccount {
  CASH
  BANK
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionType {
  STARTING_CASH
  STARTING_BANK
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  SYSTEM_CREDIT
  SYSTEM_DEBIT
  JOB_SALARY
  HUSTLE_REWARD
  HUSTLE_LOSS
}

enum IdempotencyStatus {
  COMPLETED
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  characterId  String              @unique @map("character_id") @db.Uuid
  cashBalance  BigInt              @default(0) @map("cash_balance")
  bankBalance  BigInt              @default(0) @map("bank_balance")
  version      BigInt              @default(0)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  character    Character           @relation(fields: [characterId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@unique([id, characterId])
  @@map("wallets")
}

model WalletTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  walletId        String                @map("wallet_id") @db.Uuid
  characterId     String                @map("character_id") @db.Uuid
  account         WalletAccount
  transactionType WalletTransactionType @map("transaction_type")
  direction       TransactionDirection
  amount          BigInt
  balanceBefore   BigInt                @map("balance_before")
  balanceAfter    BigInt                @map("balance_after")
  sequence        BigInt                @default(0)
  referenceType   String?               @map("reference_type") @db.VarChar(64)
  referenceId     String?               @map("reference_id") @db.Uuid
  idempotencyKey  String?               @map("idempotency_key") @db.VarChar(128)
  correlationId   String?               @map("correlation_id") @db.VarChar(80)
  metadata        Json?                 @db.JsonB
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  wallet          Wallet                @relation(fields: [walletId, characterId], references: [id, characterId], onDelete: Restrict)
  character       Character             @relation(fields: [characterId], references: [id], onDelete: Restrict)
  jobAssignment   JobAssignment?

  @@unique([walletId, sequence])
  @@index([walletId, account, sequence(sort: Desc)])
  @@index([characterId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  key            String            @db.VarChar(128)
  operation      String            @db.VarChar(80)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(COMPLETED)
  responseStatus Int               @map("response_status")
  responseBody   Json              @map("response_body") @db.JsonB
  resourceType   String?           @map("resource_type") @db.VarChar(64)
  resourceId     String?           @map("resource_id") @db.Uuid
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
  @@map("idempotency_records")
}

enum JobAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model Job {
  requiredSkillId    String?         @map("required_skill_id") @db.Uuid
  requiredSkillLvl   Int?            @map("required_skill_lvl")
  requiredSkill      Skill?          @relation("JobRequirement", fields: [requiredSkillId], references: [id], onDelete: Restrict)
  xpSkillId          String?         @map("xp_skill_id") @db.Uuid
  xpSkill            Skill?          @relation("JobXp", fields: [xpSkillId], references: [id], onDelete: Restrict)
  xpReward           BigInt          @default(0) @map("xp_reward")
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(64)
  name               String          @db.VarChar(80)
  description        String
  locationLabel      String          @map("location_label") @db.VarChar(120)
  baseReward         BigInt          @map("base_reward")
  energyCost         Int             @map("energy_cost")
  stressChange       Int             @default(0) @map("stress_change")
  cooldownSeconds    Int             @map("cooldown_seconds")
  reputationRequired BigInt          @default(0) @map("reputation_required")
  futureRequirement  String?         @map("future_requirement") @db.VarChar(160)
  isActive           Boolean         @default(true) @map("is_active")
  sortOrder          Int             @default(0) @map("sort_order")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  assignments        JobAssignment[]

  @@map("jobs")
}

model JobAssignment {
  xpSkillId     String?             @map("xp_skill_id") @db.Uuid
  xpSkill       Skill?              @relation(fields: [xpSkillId], references: [id], onDelete: Restrict)
  xpReward      BigInt              @default(0) @map("xp_reward")
  xpAwarded     BigInt              @default(0) @map("xp_awarded")
  previousLevel Int?                @map("previous_level")
  currentLevel  Int?                @map("current_level")
  id            String              @id @default(uuid()) @db.Uuid
  characterId   String              @map("character_id") @db.Uuid
  jobId         String              @map("job_id") @db.Uuid
  status        JobAssignmentStatus @default(ACTIVE)
  startedAt     DateTime            @map("started_at") @db.Timestamptz
  completesAt   DateTime            @map("completes_at") @db.Timestamptz
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz
  baseReward    BigInt              @map("base_reward")
  energyCost    Int                 @map("energy_cost")
  rewardAmount  BigInt?             @map("reward_amount")
  transactionId String?             @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  character     Character           @relation(fields: [characterId], references: [id], onDelete: Restrict)
  job           Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  transaction   WalletTransaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([characterId, status])
  @@index([characterId, startedAt(sort: Desc), id(sort: Desc)])
  @@map("job_assignments")
}

model Skill {
  hustles      Hustle[]
  id           String           @id @default(uuid()) @db.Uuid
  code         String           @unique @db.VarChar(24)
  name         String           @db.VarChar(80)
  description  String
  maxLevel     Int              @default(10) @map("max_level")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  characters   CharacterSkill[]
  requiredJobs Job[]            @relation("JobRequirement")
  xpJobs       Job[]            @relation("JobXp")
  assignments  JobAssignment[]

  @@map("skills")
}

enum HustleOutcome {
  BIG_WIN
  SUCCESS
  PARTIAL_SUCCESS
  FAILURE
  DISASTER
}

model Hustle {
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(64)
  name               String          @db.VarChar(80)
  description        String
  locationLabel      String          @map("location_label") @db.VarChar(120)
  tier               Int
  entryCost          BigInt          @default(0) @map("entry_cost")
  rewardMin          BigInt          @map("reward_min")
  rewardMax          BigInt          @map("reward_max")
  disasterLoss       BigInt          @default(0) @map("disaster_loss")
  outcomeProfile     Json            @map("outcome_profile") @db.JsonB
  baseSuccessBps     Int             @default(dbgenerated()) @map("base_success_bps")
  riskLabel          String          @map("risk_label") @db.VarChar(16)
  energyCost         Int             @map("energy_cost")
  stressMin          Int             @default(0) @map("stress_min")
  stressMax          Int             @default(0) @map("stress_max")
  heatMin            Int             @default(0) @map("heat_min")
  heatMax            Int             @default(0) @map("heat_max")
  reputationMin      Int             @default(0) @map("reputation_min")
  reputationMax      Int             @default(0) @map("reputation_max")
  requiredReputation BigInt          @default(0) @map("required_reputation")
  requiredSkillId    String          @map("required_skill_id") @db.Uuid
  requiredSkillLevel Int             @map("required_skill_level")
  requiredSkill      Skill           @relation(fields: [requiredSkillId], references: [id], onDelete: Restrict)
  cooldownSeconds    Int             @map("cooldown_seconds")
  futureRequirement  String?         @map("future_requirement") @db.VarChar(160)
  isActive           Boolean         @default(true) @map("is_active")
  testOnly           Boolean         @default(false) @map("test_only")
  sortOrder          Int             @default(0) @map("sort_order")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  attempts           HustleAttempt[]

  @@map("hustles")
}

model HustleAttempt {
  id                    String        @id @db.Uuid
  characterId           String        @map("character_id") @db.Uuid
  character             Character     @relation(fields: [characterId], references: [id], onDelete: Restrict)
  hustleId              String        @map("hustle_id") @db.Uuid
  hustle                Hustle        @relation(fields: [hustleId], references: [id], onDelete: Restrict)
  hustleName            String        @map("hustle_name") @db.VarChar(80)
  tier                  Int
  outcome               HustleOutcome
  entryCost             BigInt        @map("entry_cost")
  rewardAmount          BigInt        @map("reward_amount")
  lossAmount            BigInt        @map("loss_amount")
  energySpent           Int           @map("energy_spent")
  xpReward              BigInt        @map("xp_reward")
  xpAwarded             BigInt        @map("xp_awarded")
  previousLevel         Int           @map("previous_level")
  currentLevel          Int           @map("current_level")
  heatChange            Int           @default(0) @map("heat_change")
  reputationChange      BigInt        @default(0) @map("reputation_change")
  stressChange          Int           @default(0) @map("stress_change")
  rngVersion            String        @map("rng_version") @db.VarChar(40)
  configurationSnapshot Json          @map("configuration_snapshot") @db.JsonB
  startedAt             DateTime      @map("started_at") @db.Timestamptz
  resolvedAt            DateTime      @map("resolved_at") @db.Timestamptz
  cooldownUntil         DateTime      @map("cooldown_until") @db.Timestamptz
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([characterId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("hustle_attempts")
}

model CharacterSkill {
  characterId String    @map("character_id") @db.Uuid
  skillId     String    @map("skill_id") @db.Uuid
  level       Int       @default(1)
  xp          BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([characterId, skillId])
  @@map("character_skills")
}
