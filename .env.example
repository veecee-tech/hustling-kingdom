NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
# Development-only credentials; replace in deployed environments.
DATABASE_URL=postgresql://hk_dev:hk_dev_only@localhost:5432/hustling_kingdom?schema=public
REDIS_URL=redis://localhost:6379
# Only VITE_ variables are public. Never add secrets under this prefix.
VITE_API_BASE_URL=http://127.0.0.1:3000
# PUBLIC development fixture only. Production must supply a random secret of 32+ bytes.
JWT_ACCESS_SECRET=development-only-public-secret-never-use-in-production
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=60

# Optional local/test timing only (1–60); rejected in production.
# JOBS_DEV_DURATION_SECONDS=2
